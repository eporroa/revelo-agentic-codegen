{
  "name": "codegen-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic CLI that generates a React + TypeScript app from a natural-language spec into an existing boilerplate.",
  "bin": {
    "codegen-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/genai": "^0.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "~5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
