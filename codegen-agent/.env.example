# Copy this file to .env and fill in your keys.
#
# Which LLM provider codegen-agent uses. Defaults to "anthropic" if unset.
LLM_PROVIDER=anthropic
# Optional: override the default model for the selected provider.
# LLM_MODEL=claude-sonnet-4-5   (anthropic default)
# LLM_MODEL=gemini-flash-latest (gemini default)

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required if LLM_PROVIDER=gemini
GEMINI_API_KEY=...
